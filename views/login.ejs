<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>FullHouse Login Page</title>
		<link rel="stylesheet" href="/css/style.css" />
	</head>
	<body>
		<h1>Welcome to the <%= pageName %></h1>
		<form class="form form--login" action="/login" method="POST" novalidate>
			<div class="form__group">
				<label class="form__label" for="username">Username:</label>
				<input class="form__input" type="text" id="username" name="username" autocomplete="username" required />
			</div>

			<div class="form__group">
				<label class="form__label" for="password">Password:</label>
				<input class="form__input" type="password" id="password" name="password" autocomplete="current-password" required />
			</div>

			<button type="submit" class="btn btn--primary loginBtn">Login</button>
		</form>
	</body>
</html>
